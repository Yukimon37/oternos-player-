FROM python:3.12-bookworm

ENV PYTHONUNBUFFERED=1
ENV HIN_TECH_DISCORD_CLOUD=1
ENV HIN_TECH_DISCORD_DISABLE_LOCAL_LOCK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-discord-bot.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements-discord-bot.txt

COPY OTERNOS ./oternos

CMD ["python", "-m", "oternos", "--discord-bot", "--cloud"]
